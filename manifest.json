{
  "schemaVersion": 1,
  "id": "io.github.marioxabel.hyprsunset",
  "name": "Hyprsunset Night Light",
  "version": "1.3.0",
  "author": "marioxabel",
  "license": "MIT",
  "description": "Control night light on each monitor individually, or warm every display at once. Nothing extra to install.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Night Light",
    "description": "Night light for each monitor on its own, or for all of them together.",
    "category": "Appearance",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "nightTemperature": 4000
    },
    "schema": [
      {
        "key": "nightTemperature",
        "type": "integer",
        "label": "Night temperature (K)",
        "min": 2000,
        "max": 5500,
        "step": 100,
        "defaultValue": 4000
      }
    ]
  }
}
