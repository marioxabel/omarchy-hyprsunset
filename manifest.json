{
  "schemaVersion": 1,
  "id": "io.github.marioxabel.hyprsunset",
  "name": "Hyprsunset",
  "version": "1.0.0",
  "author": "marioxabel",
  "license": "MIT",
  "description": "Control hyprsunset night light from the Omarchy bar with an on/off switch and color temperature slider.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Night Light",
    "description": "Toggle hyprsunset and set the screen color temperature.",
    "category": "Appearance",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "nightTemperature": 4000
    },
    "schema": [
      {
        "key": "nightTemperature",
        "type": "integer",
        "label": "Night temperature (K)",
        "min": 2000,
        "max": 5500,
        "step": 100,
        "defaultValue": 4000
      }
    ]
  }
}
